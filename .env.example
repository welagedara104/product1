# Shared password for private report routes (dev default: phase0-fixture)
REPORT_ACCESS_PASSWORD=phase0-fixture

# Optional separate HMAC secret for access cookies
REPORT_AUTH_SECRET=replace-me-in-production

# Expert workspace (Phase 1)
EXPERT_ACCESS_PASSWORD=phase1-expert
EXPERT_AUTH_SECRET=replace-me-expert-secret

# Optional public app URL (used when constructing capture/OAuth callbacks)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# GA4 OAuth (optional — without these, use the tier-1 GA4 fixture)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/ga4/callback

# Creative Score API (optional — without this, fixture scores + TODO note)
# CREATIVE_SCORE_API_KEY=

# Capture: default is inline HTML. Set to "http" to hit /demo-site on the running server.
# CAPTURE_TARGET=inline
